{
  "name": "equity-researcher",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write src server scripts tests *.ts *.json index.html",
    "format:check": "prettier --check src server scripts tests *.ts *.json index.html",
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "node --watch --env-file-if-exists=.env --import tsx server/index.ts",
    "start": "node --env-file-if-exists=.env dist-server/server/index.js",
    "check:sec": "node scripts/check-sec.mjs",
    "prebuild": "node -e \"require('node:fs').rmSync('dist-server', { recursive: true, force: true })\""
  },
  "dependencies": {
    "lucide-react": "^1.64.0",
    "papaparse": "^5.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "undici": "^8.12.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
